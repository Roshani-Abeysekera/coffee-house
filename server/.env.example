# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coffeehouse"

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API server listens on
PORT=5000

# URL of the running frontend - used to build links in emails (e.g. password reset)
CLIENT_URL="http://localhost:5173"

# --- Email (optional) ---
# If these are left blank, emails are printed to the server console instead
# of actually being sent - handy for local development.
#
# Example using Gmail:
#   1. Turn on 2-Step Verification on your Google account
#   2. Create an "App password" at https://myaccount.google.com/apppasswords
#   3. Use that 16-character app password below (not your normal Gmail password)
#
# Example using Mailtrap (fake inbox for testing, no real emails sent):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<your mailtrap username>
#   SMTP_PASS=<your mailtrap password>
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Coffee House <no-reply@coffeehouse.local>"

# Where messages from the contact form are sent. Defaults to EMAIL_FROM if left blank.
CONTACT_EMAIL=""

# --- Payments (Stripe test mode) ---
# 1. Create a free account at https://dashboard.stripe.com/register
# 2. Make sure you're in TEST mode (toggle in the dashboard sidebar)
# 3. Copy your test Secret key from https://dashboard.stripe.com/test/apikeys
# Test card number for checkout: 4242 4242 4242 4242, any future expiry, any CVC, any ZIP.
STRIPE_SECRET_KEY=""
